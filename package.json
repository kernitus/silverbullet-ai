{
  "name": "silverbullet-ai",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --bun plug-compile silverbullet-ai.plug.yaml",
    "test": "bun run --bun vitest run",
    "test:integration": "bun run --bun vitest run --root integration-tests",
    "dist": "bun run build && bun scripts/build-dist.ts",
    "update-readme": "bun scripts/update-readme.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.107",
    "@ai-sdk/mcp": "^2.0.86",
    "@ai-sdk/mistral": "^4.0.74",
    "@ai-sdk/openai": "^4.0.104",
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@cfworker/json-schema": "^4.1.1",
    "@silverbulletmd/silverbullet": "^2.12.0",
    "ai": "^7.0.156"
  },
  "devDependencies": {
    "@lezer/markdown": "^1.8.1",
    "@structured-types/api": "^3.46.12",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
