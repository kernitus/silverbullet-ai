+      undefined,
+      expectedHash === null
+        ? { type: "notExists" }
+        : { type: "matchesHash", hash: expectedHash },
+    );
+  } catch (error) {
+    if (error instanceof PreconditionFailedError) {
+      await kv.batchDelete([conditionalWriteKey(path)]);
+      return {
+        status: "conflict",
+        reason: "The remote note changed after it was read",
+      };
+    }
+    return {
+      status: "unknown",
+      reason: "The server write outcome is unknown; do not retry the proposal",
+    };
+  }
+  try {
+    if (committed.remoteHash !== proposedHash) {
+      throw new Error("The server did not confirm the proposed revision");
+    }
+    const meta = await local.writeFile(path, data, committed.meta);
+    await options.recordSynced(meta, proposedHash, committed.meta);
+    await kv.batchDelete([conditionalWriteKey(path)]);
+    return { status: "applied", meta, hash: proposedHash };
+  } catch {
+    return {
+      status: "unknown",
+      reason: "The server committed the edit, but local recovery is required",
+    };
+  }
+}
+
+/** Read-only server recovery. A changed local copy is always preserved. */
+export async function recoverConditionalWrite(options: {
+  path: string;
+  local: SpacePrimitives;
+  remote: Pick<HttpSpacePrimitives, "readFileWithHash">;
+  kv: KvPrimitives;
+  recordSynced: (
+    meta: FileMeta,
+    hash: string,
+    remoteMeta: FileMeta,
+    data: Uint8Array,
+  ) => Promise<void>;
+}): Promise<ConditionalWriteResult | undefined> {
+  const { path, local, remote, kv } = options;
+  const [intent] = (await kv.batchGet([conditionalWriteKey(path)])) as [
+    ConditionalWriteIntent | undefined,
+  ];
+  if (!intent) return undefined;
+  let currentHash: string | null = null;
+  try {
+    currentHash = await hashSHA256((await local.readFile(path)).data);
+  } catch (error) {
+    if (!(error instanceof Error) || error.message !== notFoundError.message)
+      throw error;
+  }
+  if (currentHash !== intent.localHash && currentHash !== intent.proposedHash) {
+    return {
+      status: "unknown",
+      reason:
+        "Local content changed during the uncertain write; it has been preserved",
+    };
+  }
+  try {
+    const found = await remote.readFileWithHash(path);
+    if (
+      found.remoteHash !== intent.proposedHash ||
+      (await hashSHA256(found.data)) !== intent.proposedHash
+    ) {
+      return {
+        status: "unknown",
+        reason:
+          "The server no longer holds the proposed revision; manual recovery is required",
+      };
+    }
+    const meta = await local.writeFile(path, found.data, found.meta);
+    await options.recordSynced(
+      meta,
+      intent.proposedHash,
+      found.meta,
+      found.data,
+    );
+    await kv.batchDelete([conditionalWriteKey(path)]);
+    return { status: "applied", meta, hash: intent.proposedHash };
+  } catch {
+    return {
+      status: "unknown",
+      reason:
+        "Could not verify and save the server revision; the proposal has not been retried",
+    };
+  }
+}
diff --git a/client/spaces/conditional_write.test.ts b/client/spaces/conditional_write.test.ts
new file mode 100644
index 0000000..f982055
--- /dev/null
+++ b/client/spaces/conditional_write.test.ts
@@ -0,0 +1,275 @@
+import { hashSHA256 } from "@silverbulletmd/silverbullet/lib/crypto";
+import { describe, expect, test, vi } from "vitest";
+import { MemoryKvPrimitives } from "../data/memory_kv_primitives.ts";
+import { DataStoreSpacePrimitives } from "./datastore_space_primitives.ts";
+import {
+  commitConditionalWrite,
+  recoverConditionalWrite,
+  conditionalWriteKey,
+} from "./conditional_write.ts";
+import {
+  PreconditionFailedError,
+  type HttpSpacePrimitives,
+} from "./http_space_primitives.ts";
+
+const bytes = (text: string) => new TextEncoder().encode(text);
+const text = (data: Uint8Array) => new TextDecoder().decode(data);
+
+async function setup(initial: string | null = "original") {
+  let remoteHash = initial === null ? null : await hashSHA256(bytes(initial));
+  let remoteText = initial;
+  const remote: Pick<HttpSpacePrimitives, "writeFileConditional"> = {
+    writeFileConditional: vi.fn<HttpSpacePrimitives["writeFileConditional"]>(
+      async (path, data, _meta, precondition) => {
+        const nextHash = await hashSHA256(data);
+        if (
+          precondition?.type === "notExists"
+            ? remoteHash !== null
+            : precondition?.type !== "matchesHash" ||
+              precondition.hash !== remoteHash
+        ) {
+          throw new PreconditionFailedError();
+        }
+        remoteHash = nextHash;
+        remoteText = text(data);
+        return {
+          remoteHash: nextHash,
+          meta: {
+            name: path,
+            lastModified: Date.now(),
+            created: 0,
+            size: data.length,
+            perm: "rw",
+            contentType: "text/markdown",
+          },
+        };
+      },
+    ),
+  };
+  async function client() {
+    const kv = new MemoryKvPrimitives();
+    const local = new DataStoreSpacePrimitives(kv);
+    if (initial !== null) await local.writeFile("note.md", bytes(initial));
+    return { kv, local, remote, recordSynced: vi.fn(async () => {}) };
+  }
+  return {
+    client,
+    remote,
+    readRemote: () => remoteText,
+    expectedHash: remoteHash,
+  };
+}
+
+describe("conditional commit protocol", () => {
+  test.each(["original", null])(
+    "competing clients preserve one winner from %s",
+    async (initial) => {
+      const server = await setup(initial);
+      const a = await server.client();
+      const b = await server.client();
+      const results = await Promise.all(
+        [a, b].map((client, index) =>
+          commitConditionalWrite({
+            ...client,
+            path: "note.md",
+            data: bytes(`proposal ${index}`),
+            expectedHash: server.expectedHash,
+          }),
+        ),
+      );
+      expect(results.map((r) => r.status).sort()).toEqual([
+        "applied",
+        "conflict",
+      ]);
+      const winner = results.findIndex((r) => r.status === "applied");
+      expect(server.readRemote()).toBe(`proposal ${winner}`);
+      const loser = [a, b][1 - winner];
+      expect(
+        (await loser.kv.batchGet([conditionalWriteKey("note.md")]))[0],
+      ).toBeUndefined();
+      expect(loser.recordSynced).not.toHaveBeenCalled();
+      if (initial !== null)
+        expect(text((await loser.local.readFile("note.md")).data)).toBe(
+          initial,
+        );
+      else await expect(loser.local.readFile("note.md")).rejects.toThrow();
+    },
+  );
+
+  test("newer local content rejects an approved edit before any server request", async () => {
+    const server = await setup();
+    const client = await server.client();
+    await client.local.writeFile("note.md", bytes("unsynchronised user edit"));
+    const result = await commitConditionalWrite({
+      ...client,
+      path: "note.md",
+      data: bytes("proposal"),
+      expectedHash: server.expectedHash,
+    });
+    expect(result.status).toBe("conflict");
+    expect(server.remote.writeFileConditional).not.toHaveBeenCalled();
+    expect(text((await client.local.readFile("note.md")).data)).toBe(
+      "unsynchronised user edit",
+    );
+  });
+
+  test("a local deletion cannot be mistaken for an uncached remote note", async () => {
+    const server = await setup();
+    const client = await server.client();
+    await client.local.deleteFile("note.md");
+    const result = await commitConditionalWrite({
+      ...client,
+      path: "note.md",
+      data: bytes("proposal"),
+      expectedHash: server.expectedHash,
+    });
+    expect(result.status).toBe("conflict");
+    expect(server.remote.writeFileConditional).not.toHaveBeenCalled();
+  });
+
+  test("a lost response records an unknown outcome and forbids proposal replay", async () => {
+    const server = await setup();
+    const client = await server.client();
+    const commit = server.remote.writeFileConditional;
+    server.remote.writeFileConditional = vi.fn<
+      HttpSpacePrimitives["writeFileConditional"]
+    >(async (...args) => {
+      await commit(...args);
+      throw new Error("Connection lost after commit");
+    });
+    const args = {
+      ...client,
+      path: "note.md",
+      data: bytes("proposal"),
+      expectedHash: server.expectedHash,
+    };
+    expect((await commitConditionalWrite(args)).status).toBe("unknown");
+    expect((await commitConditionalWrite(args)).status).toBe("unknown");
+    expect(server.remote.writeFileConditional).toHaveBeenCalledTimes(1);
+    expect(server.readRemote()).toBe("proposal");
+    expect(
+      (await client.kv.batchGet([conditionalWriteKey("note.md")]))[0],
+    ).toBeDefined();
+    expect(text((await client.local.readFile("note.md")).data)).toBe(
+      "original",
+    );
+  });
+
+  test("a failed local checkpoint keeps the durable recovery marker", async () => {
+    const server = await setup();
+    const client = await server.client();
+    client.recordSynced.mockRejectedValueOnce(new Error("Storage failed"));
+    expect(
+      (
+        await commitConditionalWrite({
+          ...client,
+          path: "note.md",
+          data: bytes("proposal"),
+          expectedHash: server.expectedHash,
+        })
+      ).status,
+    ).toBe("unknown");
+    expect(server.readRemote()).toBe("proposal");
+    expect(
+      (await client.kv.batchGet([conditionalWriteKey("note.md")]))[0],
+    ).toBeDefined();
+  });
+
+  test("cancellation before commit leaves both copies unchanged", async () => {
+    const server = await setup();
+    const client = await server.client();
+    await expect(
+      commitConditionalWrite({
+        ...client,
+        path: "note.md",
+        data: bytes("proposal"),
+        expectedHash: server.expectedHash,
+        signal: AbortSignal.abort(),
+      }),
+    ).rejects.toThrow();
+    expect(server.remote.writeFileConditional).not.toHaveBeenCalled();
+    expect(server.readRemote()).toBe("original");
+  });
+});
+
+describe("conditional write recovery", () => {
+  test.each([false, true])(
+    "recovers a confirmed commit after local cache written=%s without resending",
+    async (localWritten) => {
+      const server = await setup();
+      const client = await server.client();
+      const proposedHash = await hashSHA256(bytes("proposal"));
+      await client.kv.batchSet([
+        {
+          key: conditionalWriteKey("note.md"),
+          value: {
+            expectedHash: server.expectedHash,
+            localHash: server.expectedHash,
+            proposedHash,
+          },
+        },
+      ]);
+      if (localWritten)
+        await client.local.writeFile("note.md", bytes("proposal"));
+      const recordSynced = vi.fn(async () => {});
+      const readFileWithHash: HttpSpacePrimitives["readFileWithHash"] =
+        async () => ({
+          data: bytes("proposal"),
+          remoteHash: proposedHash,
+          meta: {
+            name: "note.md",
+            created: 0,
+            lastModified: 23,
+            size: 8,
+            perm: "rw",
+            contentType: "text/markdown",
+          },
+        });
+      const result = await recoverConditionalWrite({
+        ...client,
+        path: "note.md",
+        recordSynced,
+        remote: { readFileWithHash },
+      });
+      expect(result?.status).toBe("applied");
+      expect(text((await client.local.readFile("note.md")).data)).toBe(
+        "proposal",
+      );
+      expect(recordSynced).toHaveBeenCalledTimes(1);
+      expect(server.remote.writeFileConditional).not.toHaveBeenCalled();
+      expect(
+        (await client.kv.batchGet([conditionalWriteKey("note.md")]))[0],
+      ).toBeUndefined();
+    },
+  );
+
+  test("preserves a later local edit and keeps sync blocked", async () => {
+    const server = await setup();
+    const client = await server.client();
+    await client.kv.batchSet([
+      {
+        key: conditionalWriteKey("note.md"),
+        value: {
+          expectedHash: server.expectedHash,
+          localHash: server.expectedHash,
+          proposedHash: await hashSHA256(bytes("proposal")),
+        },
+      },
+    ]);
+    await client.local.writeFile("note.md", bytes("later user edit"));
+    const readFileWithHash = vi.fn<HttpSpacePrimitives["readFileWithHash"]>();
+    const result = await recoverConditionalWrite({
+      ...client,
+      path: "note.md",
+      remote: { readFileWithHash },
+    });
+    expect(result?.status).toBe("unknown");
+    expect(text((await client.local.readFile("note.md")).data)).toBe(
+      "later user edit",
+    );
+    expect(readFileWithHash).not.toHaveBeenCalled();
+    expect(
+      (await client.kv.batchGet([conditionalWriteKey("note.md")]))[0],
+    ).toBeDefined();
+  });
+});
