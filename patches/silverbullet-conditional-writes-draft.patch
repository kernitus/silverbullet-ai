@@ -0,0 +1,23 @@
+/** Cooperating mutations share a native lock across tabs and workers. */
+export function withSpaceFileLock<T>(
+  spaceUrl: string,
+  path: string,
+  operation: () => Promise<T>,
+): Promise<T> {
+  const locks = globalThis.navigator?.locks;
+  // Ordinary sync remains available on older hosts. Conditional writes must
+  // require this capability before entering their commit protocol.
+  if (!locks) return operation();
+  return locks.request(
+    `silverbullet:file:${JSON.stringify([spaceUrl, path])}`,
+    operation,
+  );
+}
+
+export function requireFileLocks(): void {
+  if (!globalThis.navigator?.locks) {
+    throw new Error(
+      "Conditional writes require the Web Locks API in a secure context",
+    );
+  }
+}
