+  const { path, data, expectedHash, local, remote, kv, signal } = options;
+  if (expectedHash !== null && !/^[a-f0-9]{64}$/.test(expectedHash)) {
+    throw new Error("Expected a SHA-256 revision or null for creation");
+  }
+  signal?.throwIfAborted();
+  const [pending] = await kv.batchGet([conditionalWriteKey(path)]);
+  if (pending) {
+    return {
+      status: "unknown",
+      reason: "A previous conditional write needs recovery",
+    };
+  }
+  let current: Awaited<ReturnType<SpacePrimitives["readFile"]>> | undefined;
+  try {
+    current = await local.readFile(path);
+  } catch (error) {
+    if (!(error instanceof Error) || error.message !== notFoundError.message)
+      throw error;
+  }
