+/// Authenticated capability probe; does not make an outbound request.
+pub async fn proxy_capabilities(State(state): State<Arc<ServerState>>) -> Response {
+    if state.boot_config.read_only {
+        return (
+            StatusCode::METHOD_NOT_ALLOWED,
+            "Read only mode, no proxy allowed",
+        )
+            .into_response();
+    }
+    (
+        StatusCode::NO_CONTENT,
+        [("x-silverbullet-proxy-version", "2")],
